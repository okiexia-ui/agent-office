{
  "name": "agent-office",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "Build an AI work team on your own computer: agents with roles and models, team chat, tasks and downloadable results in a 3D office",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okiexia-ui/agent-office.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "start": "node scripts/local.mjs --env-file=.env.local --open",
    "local": "node scripts/local.mjs --env-file=.env.local",
    "pi:install": "npm install --prefix .office-local/pi-runtime --ignore-scripts --save-exact --no-audit --no-fund @earendil-works/pi-coding-agent@1.5.2",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright-core": "1.65.1",
    "prettier": "3.9.10",
    "proper-lockfile": "4.1.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
